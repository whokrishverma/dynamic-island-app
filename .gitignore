cat > ~/.gitignore_global <<'EOF'
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/
.fseventsd/
.DocumentRevisions-V100/
.TemporaryItems/
.VolumeIcon.icns

# Windows and Linux junk
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.fuse_hidden*
.Trash-*/

# Editor temporary files
*.swp
*.swo
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swn
*.code-workspace

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python caches
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
EOF

git config --global core.excludesfile ~/.gitignore_global